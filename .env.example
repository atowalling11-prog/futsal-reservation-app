import React from 'react';
import { StatusBar } from 'expo-status-bar';
import {
  StyleSheet,
  Text,
  View,
  FlatList,
  TouchableOpacity,
  SafeAreaView
} from 'react-native';

const courts = [
  { id: 1, name: 'Court A', price: '$120', slots: '09:00 • 18:00', type: 'Indoor' },
  { id: 2, name: 'Court B', price: '$140', slots: '10:00 • 17:00', type: 'Indoor' },
  { id: 3, name: 'Court C', price: '$160', slots: '08:00 • 20:00', type: 'Outdoor' }
];

export default function App() {
  return (
    <SafeAreaView style={styles.safeArea}>
      <View style={styles.container}>
        <Text style={styles.title}>Futsal Reservation</Text>
        <Text style={styles.subtitle}>Book a court in seconds</Text>

        <FlatList
          data={courts}
          keyExtractor={(item) => item.id.toString()}
          renderItem={({ item }) => (
            <View style={styles.card}>
              <Text style={styles.cardTitle}>{item.name}</Text>
              <Text style={styles.cardType}>{item.type}</Text>
              <Text style={styles.cardText}>Price: {item.price}</Text>
              <Text style={styles.cardText}>Available slots: {item.slots}</Text>
              <TouchableOpacity style={styles.button}>
                <Text style={styles.buttonText}>Reserve</Text>
              </TouchableOpacity>
            </View>
          )}
        />

        <StatusBar style="light" />
      </View>
    </SafeAreaView>
  );
}

const styles = StyleSheet.create({
  safeArea: {
    flex: 1,
    backgroundColor: '#071b2f'
  },
  container: {
    flex: 1,
    backgroundColor: '#071b2f',
    paddingTop: 28,
    paddingHorizontal: 18,
  },
  title: {
    color: '#f8fafc',
    fontSize: 30,
    fontWeight: '700',
    marginBottom: 4,
  },
  subtitle: {
    color: '#bfdbfe',
    fontSize: 16,
    marginBottom: 18,
  },
  card: {
    backgroundColor: '#0f172a',
    borderRadius: 16,
    padding: 16,
    marginBottom: 16,
    borderColor: '#1e293b',
    borderWidth: 1,
  },
  cardTitle: {
    color: '#f8fafc',
    fontSize: 22,
    fontWeight: '700',
    marginBottom: 6,
  },
  cardType: {
    color: '#7dd3fc',
    marginBottom: 8,
  },
  cardText: {
    color: '#dbeafe',
    marginBottom: 4,
  },
  button: {
    marginTop: 12,
    backgroundColor: '#22c55e',
    borderRadius: 12,
    paddingVertical: 12,
    alignItems: 'center',
  },
  buttonText: {
    color: '#fff',
    fontWeight: '700',
  },
});
